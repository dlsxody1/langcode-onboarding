# 실습 탭(labs/lab3-rag) 전용. 복사해서 .env.local 로 저장한다. 없어도 나머지 탭은 동작한다.
# Supabase 대시보드 > Project Settings > API (또는 API Keys)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 신규 키 체계면 publishable 키, 구 체계면 anon 키. 둘 중 하나만 있으면 된다. 브라우저에 노출돼도 되는 키다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠ 로컬·CI 의 색인 동기화 스크립트(npm run lab:sync) 전용. Vercel 에 절대 등록하지 않는다.
# RLS 를 건너뛰는 관리자 키다. 앱 코드(app/, lib/, middleware.ts)는 이 값을 읽지 않는다.
# 신규 키 체계면 secret 키(sb_secret_...), 구 체계면 service_role 키. 둘 중 하나만 있으면 된다.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
